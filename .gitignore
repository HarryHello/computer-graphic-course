# ===== macOS =====
.DS_Store
.AppleDouble
.LSOverride
._*

# ===== ZCode =====
.zcodeignore

# ===== 构建目录（CMake / 通用）=====
build/
build-*/
out/
cmake-build-*/

# ===== CMake 生成文件 =====
CMakeCache.txt
CMakeFiles/
CMakeLists.txt.user
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile

# ===== 编译产物 =====
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/

# ===== Xcode（CMake 生成 Xcode 工程时）=====
*.xcodeproj
xcuserdata/
DerivedData/

# ===== IDE / 编辑器 =====
.idea/
.vscode/
.vs/
*.swp
*~

# ===== Python（辅助脚本用）=====
__pycache__/
*.py[cod]
.venv/
venv/

# ===== 日志与临时文件 =====
*.log
*.tmp

# ===== 课程报告：个人信息与编译产物 =====
Report-Templates/info.typ
# 所有 PDF 一律不入库：报告 PDF 含学号，作业原文已整理进 docs/REQUEST.md，均可本地再生
*.pdf
