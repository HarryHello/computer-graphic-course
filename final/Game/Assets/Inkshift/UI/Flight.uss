.flight {
    --panel-radius: 23px;
    --control-radius: 13px;
    --chip-radius: 12px;
    flex-grow: 1;
    color: #f7fbfc;
    font-size: 20px;
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.title-screen {
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(12, 35, 55, 0.05);
}

.title-panel {
    flex-direction: column;
    justify-content: center;
    width: 49%;
    max-width: 645px;
    min-width: 500px;
    margin: 36px 0 36px 36px;
    padding: 42px 50px;
    background-color: rgba(10, 28, 47, 0.96);
    border-width: 1px;
    border-color: rgba(148, 205, 227, 0.72);
    border-radius: var(--panel-radius);
}

.eyebrow {
    color: #7ceae2;
    font-size: 17px;
    -unity-font-style: bold;
    margin: 0 0 8px 0;
}

.hero {
    font-size: 98px;
    -unity-font-style: bold;
    color: #fff9e8;
    margin: -10px 0 -4px 0;
    padding: 0;
}

.tagline {
    color: #fff1db;
    font-size: 26px;
    margin: 0 0 22px 0;
}

.ink-rule {
    width: 96px;
    height: 4px;
    margin-bottom: 26px;
    background-color: #ff9c63;
    border-radius: 2px;
}

.title-actions {
    max-width: 308px;
    margin-bottom: 24px;
}

.action {
    margin: 0 0 8px 0;
    padding: 12px 18px;
    min-height: 48px;
    color: #eefafa;
    background-color: #16354c;
    border-width: 2px;
    border-color: #325671;
    border-radius: var(--control-radius);
    transition-duration: 0.13s;
    transition-timing-function: ease-out;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.action:hover {
    background-color: #254c64;
    border-color: #9ac9d6;
    translate: 3px 0;
}

.action:focus {
    border-color: #fff0bb;
}

.action:active {
    scale: 0.97 0.97;
    translate: 2px 1px;
    background-color: #2d6177;
}

.action.primary {
    background-color: #62e6d9;
    color: #102b39;
    border-color: #62e6d9;
}

.action.primary:hover {
    background-color: #a7f6eb;
    border-color: #fff0bb;
}

.action.primary:focus {
    border-color: #fff0bb;
}

.action.primary:active {
    background-color: #51c7b9;
}

.caption {
    font-size: 16px;
    color: #b8d1da;
    margin: 0;
}

.controls {
    margin: 4px 0 0 0;
    color: #b8d1da;
    font-size: 16px;
    white-space: normal;
}

.title-stamp {
    position: absolute;
    right: 38px;
    bottom: 32px;
    padding: 10px 15px;
    background-color: rgba(10, 31, 47, 0.93);
    border-width: 1px;
    border-color: #ffa76f;
    border-radius: var(--chip-radius);
    color: #fff1db;
    font-size: 15px;
    -unity-font-style: bold;
}

.centered {
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 16, 29, 0.59);
}

.card {
    width: 70%;
    max-width: 680px;
    padding: 30px 34px;
    background-color: #0e263a;
    border-width: 1px;
    border-color: #6f9eae;
    border-radius: var(--panel-radius);
}

.title-panel,
.card,
.hint {
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.enter-from {
    opacity: 0;
    translate: 0 12px;
    scale: 0.98 0.98;
}

.section-title {
    color: #fff9e8;
    font-size: 48px;
    -unity-font-style: bold;
    margin: 0 0 12px 0;
}

.stage-list {
    margin: 10px 0 18px 0;
}

.stage-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 0 0 6px 0;
    padding: 10px 12px;
    background-color: #17384c;
    color: #f5fcff;
    border-width: 2px;
    border-color: #32566c;
    border-radius: var(--control-radius);
    transition-duration: 0.13s;
    transition-timing-function: ease-out;
}

.stage-row:hover {
    background-color: #285169;
    translate: 3px 0;
}

.stage-row:focus {
    border-color: #fff0bb;
}

.stage-row:active {
    scale: 0.98 0.98;
    background-color: #376279;
}

.stage-row:disabled {
    background-color: #142a3c;
    border-color: #294359;
    color: #9bb4c3;
    translate: 0 0;
    scale: 1 1;
}

.stage-number {
    min-width: 46px;
    font-size: 21px;
    color: #83e9df;
    -unity-font-style: bold;
}

.stage-route {
    flex-grow: 1;
}

.stage-name {
    font-size: 24px;
    margin: 0;
    -unity-font-style: bold;
}

.stage-state {
    font-size: 16px;
    -unity-font-style: bold;
    color: #c3dce3;
}

.flight-card {
    background-color: rgba(9, 28, 46, 0.91);
    border-width: 1px;
    border-color: rgba(165, 216, 229, 0.55);
    border-radius: var(--panel-radius);
    padding: 12px 17px;
}

.hud-left {
    position: absolute;
    top: 23px;
    left: 25px;
    min-width: 224px;
}

.hud-right {
    position: absolute;
    top: 23px;
    right: 25px;
    align-items: flex-end;
}

.route-name {
    font-size: 27px;
    -unity-font-style: bold;
    margin: 0 0 6px 0;
}

.meter-row {
    flex-direction: row;
    align-items: center;
}

.form {
    min-width: 66px;
    margin: 0 10px 0 0;
    padding: 2px 6px;
    color: #2e2533;
    background-color: #ffa469;
    border-radius: var(--chip-radius);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 15px;
}

.form.ball {
    color: #102b39;
    background-color: #66e8df;
}

.jump-pips {
    margin: 0;
    color: #fff1ca;
    font-size: 22px;
}

.timer {
    margin: 0;
    color: #fff9e8;
    font-size: 29px;
    -unity-font-style: bold;
}

.compass {
    margin: 0 0 0 8px;
    min-width: 28px;
    color: #8debe2;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.form,
.jump-pips,
.compass,
.checkpoint {
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.feedback-pulse {
    scale: 1.15 1.15;
}

.pause-button {
    margin: 6px 0 0 0;
    min-height: 30px;
    padding: 4px 8px;
    font-size: 14px;
}

.hint {
    position: absolute;
    left: 25px;
    bottom: 26px;
    width: 48%;
    max-width: 525px;
    border-color: rgba(255, 184, 124, 0.78);
}

.hint-body {
    margin: 0;
    color: #fff9e8;
    white-space: normal;
    font-size: 19px;
}

.checkpoint {
    position: absolute;
    right: 25px;
    bottom: 26px;
    color: #9df1e4;
    border-radius: var(--chip-radius);
    font-size: 14px;
    -unity-font-style: bold;
}

.checkpoint.reached {
    color: #132c35;
    background-color: #8ef1cf;
    border-color: #c5f9e5;
}

.dialog-actions {
    margin-top: 22px;
    max-width: 310px;
}

.loading-mark {
    color: #93eee2;
    font-size: 25px;
    -unity-font-style: bold;
}

.off {
    display: none;
}
