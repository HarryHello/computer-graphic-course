.interface {
    --dark: #13191a;
    --surface: #1d2627;
    --outline: #4c5d5c;
    --ink: #f2f4eb;
    --quiet: #aebcba;
    --cyan: #8dd5d1;
    --amber: #e8b66a;
    --radius: 4px;
    flex-grow: 1;
    color: var(--ink);
    font-size: 17px;
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.title-screen {
    justify-content: center;
    align-items: flex-start;
    padding-left: 6%;
    background-color: rgba(12, 17, 18, 0.16);
}

.title-panel {
    width: 470px;
    max-width: 88%;
    padding: 26px 32px 24px 32px;
    background-color: rgba(16, 22, 23, 0.96);
    border-width: 1px;
    border-color: var(--outline);
    border-left-width: 3px;
    border-left-color: var(--amber);
    border-radius: var(--radius);
}

.eyebrow {
    color: var(--cyan);
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0;
}

.hero {
    font-size: 74px;
    -unity-font-style: bold;
    margin: -2px 0 0 -4px;
    padding: 0;
}

.tagline {
    color: var(--quiet);
    font-size: 17px;
    margin: 0 0 19px 0;
    white-space: normal;
}

.signal-rule {
    flex-direction: row;
    height: 3px;
    margin-bottom: 20px;
    background-color: var(--outline);
}

.signal-amber {
    width: 44px;
    background-color: var(--amber);
    margin-right: 3px;
}

.signal-cyan {
    width: 12px;
    background-color: var(--cyan);
}

.title-actions {
    max-width: 268px;
}

.action,
.stage-row {
    margin: 0 0 6px 0;
    padding: 8px 12px;
    min-height: 41px;
    color: var(--ink);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--outline);
    border-radius: var(--radius);
    transition-property: background-color, scale;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.action:hover,
.stage-row:hover {
    background-color: #2d3b3b;
    border-color: var(--cyan);
}

.action:focus,
.stage-row:focus {
    border-color: #f3d5a1;
}

.action:active,
.stage-row:active {
    scale: 0.975 0.975;
    background-color: #3a4d4d;
}

.action.primary {
    background-color: var(--amber);
    color: #171812;
    border-color: #bf9353;
}

.action.primary:hover {
    background-color: #f2c784;
}

.action.primary:focus {
    border-color: #fef4dc;
    background-color: #f3c986;
}

.action.primary:active {
    background-color: #ce9752;
}

.title-progress {
    color: var(--cyan);
    font-size: 12px;
    -unity-font-style: bold;
    margin: 11px 0 17px 0;
}

.control-notes {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--outline);
}

.controls {
    width: 50%;
    margin: 0 0 4px 0;
    color: var(--quiet);
    font-size: 13px;
    white-space: normal;
}

.centered {
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 9, 9, 0.65);
}

.card {
    width: 560px;
    max-width: 90%;
    max-height: 92%;
    padding: 24px;
    background-color: var(--dark);
    border-width: 1px;
    border-color: var(--outline);
    border-top-width: 2px;
    border-top-color: var(--amber);
    border-radius: var(--radius);
}

.title-panel,
.card,
.hint {
    transition-property: opacity, translate;
    transition-duration: 190ms;
    transition-timing-function: ease-out;
}

.enter-from {
    opacity: 0;
    translate: 0 7px;
    transition-duration: 0ms;
}

.section-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--ink);
    margin: 2px 0 8px 0;
}

.stage-list {
    margin: 6px 0 12px 0;
    min-height: 0;
    flex-shrink: 1;
}

.stage-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 51px;
    padding: 6px 10px;
    background-color: #192122;
}

.stage-row:disabled {
    background-color: #171e1f;
    border-color: #313d3e;
    color: #9baba9;
}

.stage-number {
    width: 34px;
    font-size: 16px;
    color: var(--cyan);
    -unity-font-style: bold;
    margin: 0;
}

.stage-route {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.stage-name {
    font-size: 17px;
    margin: 0;
    -unity-font-style: bold;
}

.stage-route .caption {
    white-space: normal;
}

.stage-state {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--quiet);
    margin: 0 0 0 8px;
}

.stage-row:disabled .stage-number {
    color: var(--quiet);
}

.back-button {
    align-self: flex-start;
    min-width: 157px;
    margin-bottom: 0;
}

.readout {
    background-color: rgba(16, 22, 23, 0.90);
    border-width: 1px;
    border-color: var(--outline);
    border-radius: var(--radius);
    padding: 7px 10px;
}

.hud-left {
    position: absolute;
    top: 23px;
    left: 23px;
    min-width: 151px;
    border-left-width: 2px;
    border-left-color: var(--cyan);
}

.hud-right {
    position: absolute;
    top: 23px;
    right: 23px;
    align-items: flex-end;
}

.route-name {
    font-size: 19px;
    -unity-font-style: bold;
    margin: 1px 0 4px 0;
}

.route-pips {
    flex-direction: row;
    margin-top: 2px;
}

.route-pip {
    width: 17px;
    height: 2px;
    margin-right: 3px;
    background-color: #526160;
}

.route-pip.passed {
    background-color: var(--cyan);
}

.route-pip.current {
    background-color: var(--amber);
}

.meter-row,
.time-row {
    flex-direction: row;
    align-items: center;
}

.form {
    min-width: 53px;
    margin: 0 8px 0 0;
    padding: 2px 6px;
    color: #f2c784;
    background-color: #3a2c20;
    border-radius: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 13px;
}

.form.ball {
    color: #a7e3de;
    background-color: #213c3a;
}

.jump-pips {
    margin: 0;
    color: var(--ink);
    font-size: 16px;
}

.timer {
    margin: 0 9px 0 0;
    font-size: 21px;
    -unity-font-style: bold;
}

.caption {
    font-size: 13px;
    color: var(--quiet);
    margin: 0;
}

.compass {
    margin: 0 0 0 8px;
    min-width: 21px;
    color: var(--cyan);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.form,
.jump-pips,
.compass,
.checkpoint {
    transition-property: scale, color, background-color;
    transition-duration: 145ms;
    transition-timing-function: ease-out;
}

.feedback-pulse {
    scale: 1.07 1.07;
    transition-duration: 75ms;
}

.pause-button {
    margin: 0;
    min-height: 22px;
    padding: 2px 6px;
    font-size: 11px;
}

.hint {
    position: absolute;
    left: 23px;
    bottom: 23px;
    max-width: 360px;
    width: 49%;
    border-left-width: 2px;
    border-left-color: var(--amber);
    padding: 8px 11px;
}

.hint .eyebrow {
    color: var(--amber);
    margin-bottom: 3px;
}

.hint-body {
    margin: 0;
    white-space: normal;
    font-size: 15px;
}

.status {
    position: absolute;
    right: 23px;
    bottom: 23px;
    align-items: flex-end;
}

.checkpoint {
    margin: 5px 0 0 0;
    color: var(--quiet);
    font-size: 12px;
}

.checkpoint.reached {
    color: var(--cyan);
}

.dialog-card {
    width: 425px;
}

.result-text {
    color: var(--quiet);
    margin: 0;
    white-space: normal;
}

.dialog-actions {
    margin-top: 18px;
}

.load-error {
    position: absolute;
    bottom: 23px;
    align-self: center;
    color: var(--amber);
}

.blackout {
    background-color: #000;
}

.off {
    display: none;
}
