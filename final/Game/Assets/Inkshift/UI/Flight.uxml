<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Flight.uss" />
    <ui:VisualElement class="interface" picking-mode="Ignore">
        <ui:VisualElement name="titleScreen" class="screen title-screen off">
            <ui:VisualElement class="title-panel">
                <ui:Label text="PIGMENT TEST FACILITY" class="eyebrow" />
                <ui:Label text="INKSHIFT" class="hero" />
                <ui:Label text="Shift form. Follow the test routes." class="tagline" />
                <ui:VisualElement class="signal-rule" picking-mode="Ignore">
                    <ui:VisualElement class="signal-amber" picking-mode="Ignore" />
                    <ui:VisualElement class="signal-cyan" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="title-actions">
                    <ui:Button name="playButton" text="START RUN" class="action primary" />
                    <ui:Button name="stagesButton" text="SELECT ROUTE" class="action" />
                    <ui:Button name="quitButton" text="EXIT GAME" class="action" />
                </ui:VisualElement>
                <ui:Label name="titleProgress" class="title-progress" />
                <ui:VisualElement class="control-notes">
                    <ui:Label text="WASD / ARROWS   Move" class="controls" />
                    <ui:Label text="TAB   Change form" class="controls" />
                    <ui:Label text="SPACE   Double jump" class="controls" />
                    <ui:Label text="Q / E   Turn camera" class="controls" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stageScreen" class="screen centered off">
            <ui:VisualElement class="card route-card">
                <ui:Label name="stageProgress" class="eyebrow" />
                <ui:Label text="Select a route" class="section-title" />
                <ui:ScrollView name="stageList" class="stage-list" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                <ui:Button name="backButton" text="BACK TO TITLE" class="action back-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stageHud" class="screen off" picking-mode="Ignore">
            <ui:VisualElement class="readout hud-left" picking-mode="Ignore">
                <ui:Label name="routeId" class="eyebrow" picking-mode="Ignore" />
                <ui:Label name="routeName" class="route-name" picking-mode="Ignore" />
                <ui:VisualElement name="routePips" class="route-pips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="readout hud-right" picking-mode="Ignore">
                <ui:VisualElement class="time-row" picking-mode="Ignore">
                    <ui:Label name="timer" text="00:00.0" class="timer" picking-mode="Ignore" />
                    <ui:Button name="pauseButton" text="ESC" tooltip="Pause" class="action pause-button" />
                </ui:VisualElement>
                <ui:Label name="retryCount" class="caption" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hint" class="readout hint off" picking-mode="Ignore">
                <ui:Label name="hintTitle" class="eyebrow" picking-mode="Ignore" />
                <ui:Label name="hintBody" class="hint-body" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="readout status" picking-mode="Ignore">
                <ui:VisualElement class="meter-row" picking-mode="Ignore">
                    <ui:Label name="form" class="form" picking-mode="Ignore" />
                    <ui:Label name="jumpPips" class="jump-pips" tooltip="Jumps remaining" picking-mode="Ignore" />
                    <ui:Label name="compass" class="compass" tooltip="Camera heading" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="checkpoint" class="checkpoint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dialog" class="screen centered off">
            <ui:VisualElement class="card dialog-card">
                <ui:Label name="dialogEyebrow" class="eyebrow" />
                <ui:Label name="dialogTitle" class="section-title" />
                <ui:Label name="dialogText" class="result-text" />
                <ui:VisualElement name="dialogActions" class="dialog-actions" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="loadError" text="Route unavailable. Check the build profile." class="readout load-error off" picking-mode="Ignore" />
        <ui:VisualElement name="blackout" class="screen blackout" picking-mode="Position" />
    </ui:VisualElement>
</ui:UXML>
