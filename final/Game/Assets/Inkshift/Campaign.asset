%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b412c48eb431d48e4b3406506a983a5b, type: 3}
  m_Name: Campaign
  m_EditorClassIdentifier: Assembly-CSharp::Inkshift.Campaign
  menuScene: InkshiftTitle
  stages:
  - Id: first-marks
    Scene: FirstMarks
    Title: First Marks
    Focus: CUBE STEPS   /   DOUBLE JUMP
    Brief: Flip one cube length at a time. Jump between stones, and use Q / E to
      turn at the junctions.
  - Id: slipstream
    Scene: Slipstream
    Title: Slipstream
    Focus: BALL SPEED   /   RAMP FLIGHT
    Brief: Switch to ball and build speed through the dip. Switch back to cube to
      brake at the next station.
  - Id: quarter-turn
    Scene: QuarterTurn
    Title: Quarter Turn
    Focus: FOUR HEADINGS   /   TURNING
    Brief: Follow the arrows through all four headings. Q and E turn the camera;
      W follows its new direction.
  - Id: cloudline
    Scene: Cloudline
    Title: Transfer Wing
    Focus: FULL ROUTE   /   RISING PLATFORMS
    Brief: Cross the beams, take the ball ramp, then brake and climb. Choose the
      shape that suits each section.
